# All rules are disabled by default (opt-in).
# Enabling them in the consuming project:
#
# parameters:
#     tournayreLabsPhpstanRules:
#         interfaceNameSuffix: true
#         loggerInCatch: true
#         doctrineQueryCall: true
#         doctrineQueryAllowedClasses: ['App\Service\Search\*']
#         doctrinePersistenceCall: true
#         doctrinePersistenceAllowedClasses: ['App\Service\UnitOfWork']
#         doctrineAllowObjectRepositories: true
#         doctrineRepositoryNoInheritance: false
#         symfonyAutowireEnv: true
#         symfonyAutowireEnvAllowedClasses: ['App\Config\*']
#         forbiddenInterfaces:
#             -
#                 namespaces: ['App\Domain\*']
#                 interfaces: ['Countable', 'Psr\Log\*']
#             -
#                 namespaces: ['App\Application\*']
#                 preset: clock
#                 message: 'Implement your own clock in App\Infrastructure.'
#
# forbiddenInterfaces: list of independent entries; a class/enum/interface whose FQCN matches one of
# "namespaces" must not declare (implements / interface extends) one of "interfaces" and/or "preset" ("*" wildcards).
# Presets: clock = Psr\Clock\ClockInterface + Symfony\Component\Clock\ClockInterface. "message" is shown as a tip.
#
# symfonyAutowireEnv: forbids #[Autowire(env: '...')] (and '%env(...)%' values); the allowed classes
# are the configuration objects that read the environment variables.
#
# Doctrine call rules: by default, classes implementing Doctrine\Persistence\ObjectRepository
# are allowed, plus the class name patterns ("*" wildcard) of the "AllowedClasses" lists.
# With doctrineAllowObjectRepositories: false only the patterns count (DDD: e.g. 'App\Infrastructure\Persistence\*'),
# which is what you want together with doctrineRepositoryNoInheritance.
parameters:
    tournayreLabsPhpstanRules:
        interfaceNameSuffix: false
        loggerInCatch: false
        doctrineQueryCall: false
        doctrineQueryAllowedClasses: []
        doctrinePersistenceCall: false
        doctrinePersistenceAllowedClasses: []
        doctrineAllowObjectRepositories: true
        doctrineRepositoryNoInheritance: false
        symfonyAutowireEnv: false
        symfonyAutowireEnvAllowedClasses: []
        forbiddenInterfaces: []

parametersSchema:
    tournayreLabsPhpstanRules: structure([
        interfaceNameSuffix: bool()
        loggerInCatch: bool()
        doctrineQueryCall: bool()
        doctrineQueryAllowedClasses: listOf(string())
        doctrinePersistenceCall: bool()
        doctrinePersistenceAllowedClasses: listOf(string())
        doctrineAllowObjectRepositories: bool()
        doctrineRepositoryNoInheritance: bool()
        symfonyAutowireEnv: bool()
        symfonyAutowireEnvAllowedClasses: listOf(string())
        forbiddenInterfaces: listOf(structure([
            namespaces: listOf(string())
            ?interfaces: listOf(string())
            ?preset: string()
            ?message: string()
        ]))
    ])

services:
    -
        class: TournayreLabs\PHPStanRules\Rules\InterfaceNameSuffixRule
    -
        class: TournayreLabs\PHPStanRules\Rules\LoggerInCatchRule
    -
        class: TournayreLabs\PHPStanRules\Rules\DoctrineQueryCallRule
        arguments:
            allowedClasses: %tournayreLabsPhpstanRules.doctrineQueryAllowedClasses%
            allowObjectRepositories: %tournayreLabsPhpstanRules.doctrineAllowObjectRepositories%
    -
        class: TournayreLabs\PHPStanRules\Rules\DoctrinePersistenceCallRule
        arguments:
            allowedClasses: %tournayreLabsPhpstanRules.doctrinePersistenceAllowedClasses%
            allowObjectRepositories: %tournayreLabsPhpstanRules.doctrineAllowObjectRepositories%
    -
        class: TournayreLabs\PHPStanRules\Rules\DoctrineRepositoryNoInheritanceRule
    -
        class: TournayreLabs\PHPStanRules\Rules\SymfonyAutowireEnvRule
        arguments:
            allowedClasses: %tournayreLabsPhpstanRules.symfonyAutowireEnvAllowedClasses%
    -
        class: TournayreLabs\PHPStanRules\Rules\ForbiddenInterfaceRule
        arguments:
            configurations: %tournayreLabsPhpstanRules.forbiddenInterfaces%

conditionalTags:
    TournayreLabs\PHPStanRules\Rules\InterfaceNameSuffixRule:
        phpstan.rules.rule: %tournayreLabsPhpstanRules.interfaceNameSuffix%
    TournayreLabs\PHPStanRules\Rules\LoggerInCatchRule:
        phpstan.rules.rule: %tournayreLabsPhpstanRules.loggerInCatch%
    TournayreLabs\PHPStanRules\Rules\DoctrineQueryCallRule:
        phpstan.rules.rule: %tournayreLabsPhpstanRules.doctrineQueryCall%
    TournayreLabs\PHPStanRules\Rules\DoctrinePersistenceCallRule:
        phpstan.rules.rule: %tournayreLabsPhpstanRules.doctrinePersistenceCall%
    TournayreLabs\PHPStanRules\Rules\DoctrineRepositoryNoInheritanceRule:
        phpstan.rules.rule: %tournayreLabsPhpstanRules.doctrineRepositoryNoInheritance%
    TournayreLabs\PHPStanRules\Rules\SymfonyAutowireEnvRule:
        phpstan.rules.rule: %tournayreLabsPhpstanRules.symfonyAutowireEnv%
    # forbiddenInterfaces: always tagged, it reports nothing while the list is empty.
    TournayreLabs\PHPStanRules\Rules\ForbiddenInterfaceRule:
        phpstan.rules.rule: true

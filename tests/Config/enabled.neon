parameters:
    tournayreLabsPhpstanRules:
        interfaceNameSuffix: true
        controllerEntityManager: true
        doctrineQueryCall: true
        doctrineQueryAllowedClasses: ['App\Service\Search\*']
        doctrinePersistenceCall: true
        doctrineAllowObjectRepositories: false
        doctrineRepositoryNoInheritance: true
        symfonyAutowireEnv: true
        symfonyAutowireEnvAllowedClasses: ['App\Config\*']
        namedArguments: true
        noInstanceofOnForbiddenDependency: true
        noInstanceofOnForbiddenDependencyRestrictions:
            - {dependency: 'Vendor\Library\', denyFrom: 'App\Domain\', reason: 'the domain must not know the library'}
        forbiddenInterfaces:
            -
                namespaces: ['App\Domain\*']
                interfaces: ['Countable']
            -
                namespaces: ['App\Application\*']
                preset: clock
                message: 'Use your own clock.'
